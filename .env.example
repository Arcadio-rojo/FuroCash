DB_NAME=furocash
DB_USER=furocash
DB_PASSWORD=change_me
# Optional: override the default localhost:5433 JDBC URL.
# DB_URL=jdbc:postgresql://localhost:5433/furocash
JWT_SECRET=change_me_to_a_random_string_of_32_or_more_characters
PORT=7070
FRONTEND_ORIGIN=http://localhost:5173
SMS_MODE=philsms
PHILSMS_API_BASE_URL=https://dashboard.philsms.com/api/v3/
PHILSMS_API_TOKEN=
# Use a Sender ID enabled in your PhilSMS account.
PHILSMS_SENDER_ID=PhilSMS
# Optional alternative provider (SMS_MODE=semaphore):
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Enables simulated funding only. Disable outside local demos.
DEMO_CASH_IN=false

# Maximum manual simulated deposit amount.
DEMO_MANUAL_DEPOSIT_MAX=50000
